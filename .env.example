# Clow Environment Variables Configuration
# Copy this file to .env and replace with your local values.
# NEVER COMMIT .env TO VERSION CONTROL.

# Environment
CLOW_ENVIRONMENT=development

# MetaTrader 5 Connection Settings
CLOW_MT5__SERVER=MetaQuotes-Demo
CLOW_MT5__LOGIN=0
CLOW_MT5__PASSWORD=
CLOW_MT5__PATH=
CLOW_MT5__TIMEOUT_SECONDS=30

# Risk Management & Sovereign Gates
CLOW_RISK__MAX_ACCOUNT_RISK_PCT=1.0
CLOW_RISK__MAX_DAILY_DRAWDOWN_PCT=4.0
CLOW_RISK__MAX_OPEN_TRADES=3
CLOW_RISK__MAX_SPREAD_PIPS=2.5
CLOW_RISK__MIN_CONFIDENCE_THRESHOLD=0.65

# AI Model Configuration
CLOW_MODELS__FOUNDATION_MODEL=amazon/chronos-t5-small
CLOW_MODELS__CONTEXT_LENGTH=64
CLOW_MODELS__BATCH_SIZE=32
CLOW_MODELS__LEARNING_RATE=0.0001
CLOW_MODELS__DEVICE=auto

# Telemetry and Logging
CLOW_LOGGING__LEVEL=INFO
CLOW_LOGGING__JSON_FORMAT=false
CLOW_LOGGING__LOG_DIR=logs
